# Build the SPA and serve it via nginx, proxying /api to the backend.
FROM node:20-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
# ci, not install: the lockfile is the point of committing one, and `npm install` will
# happily resolve a different tree in the image than CI typechecked.
RUN npm ci
COPY web/ ./
# `npm run gen:api` used to run here as `|| true`. It writes src/api/gen/schema.d.ts,
# which nothing imports (src/api/ does not exist) — so the step could only ever fail
# silently or succeed pointlessly. Run it deliberately if the generated client is ever
# adopted; do not run it as a no-op that hides its own errors.
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
